 {:deps {org.clj-commons/pretty {:mvn/version "3.5.0"}}
  :tasks
  {:requires ([clojure.string :as str]
              [clj-commons.ansi :as ansi]
              [babashka.cli :as cli])
   :init (do
           (defn shell' [c]
             (do
               (println
                (if ansi/*color-enabled*
                   (ansi/compose [:italic.green "λ> "] [:bold.bright-white c])
                   (str "$ ")))
                (shell c)))
           (defn nh-os [t]
             (let [os (System/getProperty "os.name")
                   command (case os
                             "Mac OS X" "darwin"
                             "Linux" "os")]
               (shell' (str "nh " command " " t " . --ask -- --accept-flake-config")))))
   s (run 'switch)
   sh (run 'switch-home)
   b (run 'boot)
   u (run 'update)
   ua (run 'update-all-inputs)
   udb (run 'update-nix-index-db)
   c (run 'clean-user)
   ca (run 'clean-all)
   op (run 'optimize)

   switch (nh-os "switch")
   switch-home (shell "nh home switch . --ask")
   boot (nh-os "boot")
   update (do
            (run 'update-main-inputs)
            (run 'switch))
   update-all-inputs (shell' "nix flake update")
   update-main-inputs (let [main-inputs ["nixpkgs" "home-manager" "nix-darwin" "chaotic"]]
                        (shell' (str "nix flake update " (str/join " " main-inputs))))
   update-nix-index-db (do
                         (shell' "jj new -m \"chore(deps): Update nix-index-database\"")
                         (shell' "nix flake update nix-index-database")
                         (run 'switch))
   gc-store (shell' "nix store gc")
   gc-legacy (shell' "sudo nix-collect-garbage -d")
   clean-user (let [options (cli/parse-opts *command-line-args* {:alias {:k :keep}})]
                (shell' (if (contains? options :keep)
                          (str "nh clean user --keep-since " (:keep options))
                          "nh clean user")))
   clean-all (shell' "nh clean all")
   optimize (shell' "nix store optimise")
   optimise (run 'optimize)
   wipe-profile (shell' "nix profile wipe-history")
   restart-nix-daemon-darwin (do
                               (shell' "sudo launchctl load /Library/LaunchDaemons/org.nixos.nix-daemon.plist")
                               (shell' "sudo launchctl start org.nixos.nix-daemon"))}}
